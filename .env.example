# Credential values are never placed in the environment. These host paths are
# consumed by Compose and mounted read-only below /run/secrets/.
DISCORD_TOKEN_FILE=secrets/discord_token
MYSQL_PASSWORD_FILE=secrets/mariadb_app_password
MYSQL_ROOT_PASSWORD_FILE=secrets/mariadb_root_password
DISCORD_GUILD_ID=

# Local image defaults are not release evidence. A reviewed candidate build
# supplies its full Git SHA and records the resulting image ID/digest.
UMA_ST2_IMAGE=uma-st-2:v2-local
SOURCE_COMMIT=unrecorded

MYSQL_DATABASE=uma_st_2
MYSQL_USER=uma_st_2

# Deployment policy values. Runtime startup fails when any value is absent,
# non-positive, or outside the validated bound.
WIN5_DELIVERY_POLL_INTERVAL_SECONDS=10
WIN5_DELIVERY_BATCH_SIZE=10
WIN5_DELIVERY_MAX_ATTEMPTS=3
WIN5_DELIVERY_RETRY_DELAY_SECONDS=300
WIN5_DELIVERY_PENDING_TIMEOUT_SECONDS=900

LOG_LEVEL=INFO
