# Direct Python runs use this host path. Docker Compose mounts the same file at
# /run/secrets/discord_token and never injects its value into Config.Env.
DISCORD_TOKEN_FILE=secrets/discord_token
DISCORD_GUILD_ID=
DISCORD_ADMIN_CHANNEL_IDS=
OWNER_ROLE_ID=

MYSQL_DATABASE=uma_st2
MYSQL_USER=uma_st2
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root
DATABASE_URL=mysql+pymysql://uma_st2:change-me@mariadb:3306/uma_st2?charset=utf8mb4

APP_TIMEZONE=Asia/Seoul
APP_UTC_OFFSET_MINUTES=540
LOG_LEVEL=INFO
ENABLE_LEGACY_PLAYER_LINK=false

DEFAULT_MATCH_POINTS=500
MIN_MATCH_BET_AMOUNT=10
MAX_MATCH_BET_AMOUNT=21474836470
BET_CLOSE_MINUTES=30

EXPORT_DIR=/app/exports
BACKUP_DIR=/app/backups
